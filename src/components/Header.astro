---
import { SITE_TAGLINE, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

const links = [
  { href: `${base}products/`, label: '产品' },
  { href: `${base}diary/`, label: '日记' },
  { href: `${base}resources/`, label: '资源' },
  { href: `${base}about/`, label: '关于' },
];

function isCurrent(href: string) {
  if (href === base || href === `${base}`) {
    return pathname === base || pathname === `${base}` || pathname === '/';
  }
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={base}>
      <span class="brand__title">{SITE_TITLE}</span>
      <span class="brand__tagline">{SITE_TAGLINE}</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <button class="nav-toggle" type="button" aria-label="打开菜单" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<nav class="nav-overlay" aria-label="移动端导航">
  {
    links.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }
</nav>

<script>
  const toggle = document.querySelector('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  });
  document.querySelectorAll('.nav-overlay a').forEach((link) => {
    link.addEventListener('click', () => document.body.classList.remove('nav-open'));
  });
</script>
