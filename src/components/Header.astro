---
import { SITE_TAGLINE, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

const links = [
  { href: `${base}diary/`, label: '日记' },
  { href: `${base}products/`, label: '产品' },
  { href: `${base}resources/`, label: '资源' },
  { href: `${base}about/`, label: '关于' },
];

function isCurrent(href: string) {
  if (href === base || href === `${base}`) {
    return pathname === base || pathname === `${base}` || pathname === '/';
  }
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={base}>
      <span class="brand__title">{SITE_TITLE}</span>
      <span class="brand__tagline">{SITE_TAGLINE}</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
