---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import { PRODUCT_STATUS_LABELS } from '../../consts';
import { getPublishedProducts } from '../../lib/content';

export async function getStaticPaths() {
  const products = await getPublishedProducts();
  return products.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const links = [
  entry.data.url && { href: entry.data.url, label: '在线地址' },
  entry.data.repo && { href: entry.data.repo, label: '仓库' },
  entry.data.docs && { href: entry.data.docs, label: '文档' },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-header reveal">
      <span class="eyebrow">Work</span>
      <h1>{entry.data.title}</h1>
      <div class="entry-meta">
        <span class="badge badge--status">{PRODUCT_STATUS_LABELS[entry.data.status]}</span>
      </div>
      <p>{entry.data.summary}</p>
    </header>

    {
      entry.data.cover && (
        <Image
          class="product-cover"
          src={entry.data.cover}
          alt={entry.data.title}
          widths={[800, 1200]}
          sizes="(min-width: 720px) 52rem, 100vw"
        />
      )
    }

    {
      links.length > 0 && (
        <ul class="product-links">
          {links.map((link) => (
            <li>
              <a class="btn-pill" href={link.href} rel="noopener noreferrer">
                {link.label}
                <span class="btn-pill__icon">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      entry.data.video && (
        <section class="product-media reveal">
          <span class="eyebrow">Demo</span>
          <h2 class="product-media__title">演示视频</h2>
          <div class="product-video">
            <video controls playsinline preload="metadata" src={entry.data.video} />
          </div>
        </section>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      entry.data.gallery && entry.data.gallery.length > 0 && (
        <section class="product-media reveal">
          <span class="eyebrow">Promo</span>
          <h2 class="product-media__title">宣传卡片</h2>
          <div class="product-gallery">
            {entry.data.gallery.map((img, i) => (
              <div class="product-gallery__item">
                <Image
                  src={img}
                  alt={`${entry.data.title} 宣传卡片 ${i + 1}`}
                  widths={[400, 800]}
                  sizes="(min-width: 720px) 22rem, 100vw"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
