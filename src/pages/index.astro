---
import { Image } from 'astro:assets';
import AuthorshipBadge from '../components/AuthorshipBadge.astro';
import BaseLayout from '../components/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE, PRODUCT_STATUS_LABELS } from '../consts';
import {
  diaryPath,
  formatDate,
  getPublishedDiary,
  getPublishedProducts,
  getPublishedResources,
  productPath,
  resourcePath,
} from '../lib/content';

const base = import.meta.env.BASE_URL;
const diary = (await getPublishedDiary()).slice(0, 5);
const products = (await getPublishedProducts()).slice(0, 4);
const resources = (await getPublishedResources()).slice(0, 4);
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p>{SITE_TAGLINE}。公开记录 AI 实践、可指名的作品，以及值得分享的资源。</p>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>最新日记</h2>
      <a href={`${base}diary/`}>全部日记 →</a>
    </div>
    {
      diary.length === 0 ? (
        <EmptyState message="还没有日记。在 src/content/diary/ 添加 Markdown 即可。" />
      ) : (
        <ul class="card-list">
          {diary.map((entry) => (
            <li>
              <a class="card" href={`${base}${diaryPath(entry)}`}>
                <div class="card__meta">
                  <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                  <AuthorshipBadge authorship={entry.data.authorship} />
                </div>
                <h3 class="card__title">{entry.data.title}</h3>
                {entry.data.description && <p class="card__desc">{entry.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="section">
    <div class="section__head">
      <h2>产品</h2>
      <a href={`${base}products/`}>全部产品 →</a>
    </div>
    {
      products.length === 0 ? (
        <EmptyState message="还在搬进来。产品是可指名的稳定作品，不是单次实验。" />
      ) : (
        <div class="grid-2">
          {products.map((entry) => (
            <a class="card" href={`${base}${productPath(entry)}`}>
              {entry.data.cover && (
                <Image
                  class="card__cover"
                  src={entry.data.cover}
                  alt={entry.data.title}
                  widths={[400, 800]}
                  sizes="(min-width: 720px) 25rem, 100vw"
                />
              )}
              <div class="card__meta">
                <span class="badge badge--status">{PRODUCT_STATUS_LABELS[entry.data.status]}</span>
              </div>
              <h3 class="card__title">{entry.data.title}</h3>
              <p class="card__desc">{entry.data.summary}</p>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="section">
    <div class="section__head">
      <h2>资源</h2>
      <a href={`${base}resources/`}>浏览资源库 →</a>
    </div>
    {
      resources.length === 0 ? (
        <EmptyState message="还在搬进来。资源是收藏与短评，不是产品页。" />
      ) : (
        <ul class="card-list">
          {resources.map((entry) => (
            <li>
              <a class="card" href={`${base}${resourcePath(entry)}`}>
                <h3 class="card__title">{entry.data.title}</h3>
                <p class="card__desc">{entry.data.blurb}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
