---
import { render } from 'astro:content';
import AuthorshipBadge from '../../components/AuthorshipBadge.astro';
import BaseLayout from '../../components/BaseLayout.astro';
import { formatDate, getPublishedDiary } from '../../lib/content';

export async function getStaticPaths() {
  const diary = await getPublishedDiary();
  return diary.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description ?? entry.data.title}>
  <article>
    <header class="page-header">
      <h1>{entry.data.title}</h1>
      <div class="entry-meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        <AuthorshipBadge authorship={entry.data.authorship} />
      </div>
      {
        entry.data.authorshipNote && (
          <p class="authorship-note">{entry.data.authorshipNote}</p>
        )
      }
      {
        entry.data.tags.length > 0 && (
          <div class="tag-list">
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
