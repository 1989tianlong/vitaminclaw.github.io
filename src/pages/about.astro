---
import { Image } from 'astro:assets';
import BaseLayout from '../components/BaseLayout.astro';
import { SITE_TAGLINE, SITE_TITLE } from '../consts';
import heroImg from '../assets/about/hero.png';
import productsImg from '../assets/about/products.png';
import diaryImg from '../assets/about/diary.png';
import resourcesImg from '../assets/about/resources.png';

const base = import.meta.env.BASE_URL;

const sections = [
  {
    img: productsImg,
    title: '产品',
    href: `${base}products/`,
    text: '9 个真能用的东西：从哄娃的小芽记、正念的 sati，到管理 ~/.zshrc 的 macOS 工具 EnvBoard。每个都有简介、状态和源码，欢迎试用、提 issue。',
  },
  {
    img: diaryImg,
    title: '日记',
    href: `${base}diary/`,
    text: '每天让 AI 对当天摸过的工具做第一性原理拆解，写下什么值得用、怎么用。每篇都老实标明「我写的 / AI 生成 / 人机协作」。',
  },
  {
    img: resourcesImg,
    title: '资源',
    href: `${base}resources/`,
    text: '不是收藏夹，是筛过的：日记里评分 ⭐≥4 的工具会被自动抽出来，附上核心价值和使用指南；另有各家官方开发文档。',
  },
];
---

<BaseLayout title="关于" description={`${SITE_TITLE}：${SITE_TAGLINE}`}>
  <header class="page-header reveal">
    <span class="eyebrow">About</span>
    <h1>关于</h1>
    <p>你好，我是 VitaminClaw。这里是我和 AI 一起干活的地方，全部公开。</p>
  </header>

  <Image
    class="about-hero reveal"
    src={heroImg}
    alt="深夜书桌：笔记本电脑、摊开的笔记本与咖啡，台灯暖光"
    widths={[800, 1200, 1600]}
    sizes="(min-width: 720px) 54rem, 100vw"
  />

  <article class="prose">
    <p>
      这个站的内容就是仓库里的 Markdown，站点本身开源在 GitHub 上。
      你看到的一切——内容、配图、部署——都有 AI 参与，它不是 AI 的展示橱窗，
      而是一套真实在跑的协作流程。
    </p>
  </article>

  <div class="about-grid">
    {
      sections.map((section) => (
        <a class="card card--bezel reveal" href={section.href}>
          <div class="card__core">
            <Image
              class="card__cover"
              src={section.img}
              alt={section.title}
              widths={[400, 800]}
              sizes="(min-width: 720px) 17rem, 100vw"
            />
            <h2 class="card__title">{section.title}</h2>
            <p class="card__desc">{section.text}</p>
          </div>
        </a>
      ))
    }
  </div>

  <article class="prose">
    <p>
      每晚 23:07，一个定时任务会自动同步日记、抽取资源、构建部署——我睡觉，它上班。
      所以这里每天都在长。
    </p>
    <p>
      源码在 <a href="https://github.com/1989tianlong/vitaminclaw.github.io">vitaminclaw.github.io</a>，
      人是 <a href="https://github.com/1989tianlong">@1989tianlong</a>。
      发现错误、想聊工具、或者只是路过，都欢迎来打个招呼。
    </p>
  </article>
</BaseLayout>
